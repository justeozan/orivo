        rim-cycle: 6300ms;
        StrokeIcon {
            x: 11px;
            y: 9px;
            width: 16px;
            height: 16px;
            tone: #cfcbd2;
            path-data: "M 3 3 H 9 V 9 H 3 Z M 15 3 H 21 V 9 H 15 Z M 3 15 H 9 V 21 H 3 Z M 15 15 H 21 V 21 H 15 Z";
        }
    }

    Rectangle {
        x: 72px;
        y: parent.height - 340px;
        width: parent.width - 72px;
        height: 216px;
        // The viewport deliberately does not clip: the selected card can use a
        // fine lavender rim without truncating the far-right continuation.
        clip: false;

        for card-image[index] in root.rail-covers : Rectangle {
            // Seven full cards plus the next card's edge match the reference;
            // the remaining games stay deliberately discoverable via the rail.
            x: (index - root.rail-first-index) * 204px + (index > root.selected-index ? 20px : 0px);
            y: index == root.selected-index ? 0px : 8px;
            width: index == root.selected-index ? 216px : 200px;
            height: index == root.selected-index ? 216px : 204px;
            background: transparent;
            border-radius: 12px;
            clip: false;
            opacity: index == root.selected-index ? 1 : 0.94;
            animate opacity { duration: 180ms; easing: ease-in-out; }

            Rectangle {
                width: parent.width;
                height: parent.height;
                background: #17171b;
                border-width: index == root.selected-index ? 2px : 1px;
                border-color: index == root.selected-index ? #c3b5ff : #ffffff32;
                border-radius: 12px;
                clip: true;

                Image {
                    x: index == root.selected-index ? 2px : 1px;
                    y: index == root.selected-index ? 2px : 1px;
                    width: parent.width - (index == root.selected-index ? 4px : 2px);
                    height: parent.height - (index == root.selected-index ? 4px : 2px);
                    source: card-image;
                    image-fit: cover;
                    accessible-label: root.rail-titles[index];
                }
                Rectangle {
                    x: 0px;
                    y: parent.height - 89px;
                    width: parent.width;
                    height: 89px;
                    background: @linear-gradient(0deg, #090a0eee 0%, #090a0d93 53%, #0b0b0d00 100%);
                }
                Rectangle {
                    x: 1px;
                    y: 1px;
                    width: parent.width - 2px;
                    height: parent.height - 2px;
                    background: @linear-gradient(180deg, #ffffff14 0%, #ffffff00 34%);
                    border-radius: 11px;
                }
                Text {
                    x: 16px;
                    y: parent.height - 53px;
                    width: parent.width - 30px;
                    height: 22px;
                    text: root.rail-titles[index];
                    color: #f3f0f3;
                    font-family: "SF Pro Text";
                    font-size: 15px;
                    font-weight: 600;
                    vertical-alignment: center;
                }
                Text {
                    x: 16px;
                    y: parent.height - 31px;
                    width: parent.width - 30px;
                    height: 18px;
                    text: root.rail-metadata[index];
                    color: #b6b0bb;
                    font-family: "SF Pro Text";
                    font-size: 13px;
                    vertical-alignment: center;
                }
            }
            /*
             * The interaction lives outside the clipping rectangle so the card
             * stays tappable right up to its illuminated rim.
             */
            TouchArea { clicked => { root.select-game(index); } }
        }
    }

    // The fixed controller HUD gives the bottom edge purpose without another panel.
    Rectangle {
        x: 67px;
        y: parent.height - 60px;
        width: 37px;
        height: 3px;
        background: #33313a;
        border-radius: 2px;
    }
    Rectangle {
        x: 96px;
        y: parent.height - 61px;
        width: 7px;
        height: 7px;
        background: #7d54f4;
        border-radius: 4px;
    }
    Text {
        x: 111px;
        y: parent.height - 70px;
        width: 70px;
        height: 24px;
        text: "Popular";
        color: #eeebf0;
        font-family: "SF Pro Text";
        font-size: 13px;
        vertical-alignment: center;
    }

    Rectangle { x: parent.width / 2 - 299px; y: parent.height - 60px; width: 100px; height: 3px; background: #ffffff18; border-radius: 2px; }
    Rectangle { x: parent.width / 2 - 184px; y: parent.height - 60px; width: 100px; height: 3px; background: #7d54f4; border-radius: 2px; }
    Rectangle { x: parent.width / 2 - 69px; y: parent.height - 60px; width: 100px; height: 3px; background: #ffffff18; border-radius: 2px; }
    Rectangle { x: parent.width / 2 + 46px; y: parent.height - 60px; width: 100px; height: 3px; background: #ffffff18; border-radius: 2px; }
    Rectangle { x: parent.width / 2 + 161px; y: parent.height - 60px; width: 100px; height: 3px; background: #ffffff18; border-radius: 2px; }

    Rectangle {
        x: parent.width - 333px;
        y: parent.height - 73px;
        width: 24px;
        height: 24px;
        background: #ffffff14;
        border-radius: 12px;
        StrokeIcon {
            x: 7px;
            y: 7px;
            width: 10px;
            height: 10px;
            tone: #ddd9df;
            path-data: "M 12 2 V 22 M 2 12 H 22";
        }
    }
    Text {
        x: parent.width - 300px;
        y: parent.height - 73px;
        width: 65px;
        height: 24px;
        text: "Navigate";
        color: #c8c4cb;
        font-family: "SF Pro Text";
        font-size: 13px;
        vertical-alignment: center;
    }
    Rectangle {
        x: parent.width - 207px;
        y: parent.height - 73px;
        width: 24px;
        height: 24px;
        background: #1e5131;
        border-radius: 12px;
        Text {
            width: parent.width;
            height: parent.height;
            text: "A";
            color: #74e392;
            font-family: "SF Pro Text";
            font-size: 13px;
            font-weight: 700;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
    Text {
        x: parent.width - 174px;
        y: parent.height - 73px;
        width: 44px;
        height: 24px;
        text: "Select";
        color: #c8c4cb;
        font-family: "SF Pro Text";
        font-size: 13px;
        vertical-alignment: center;
    }
    Rectangle {
        x: parent.width - 108px;
        y: parent.height - 73px;
        width: 24px;
        height: 24px;
        background: #4c2428;
        border-radius: 12px;
        Text {
            width: parent.width;
            height: parent.height;
            text: "B";
            color: #f06b6e;
            font-family: "SF Pro Text";
            font-size: 13px;
            font-weight: 700;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
    Text {
        x: parent.width - 75px;
        y: parent.height - 73px;
        width: 35px;
        height: 24px;
        text: "Back";
        color: #c8c4cb;
        font-family: "SF Pro Text";
        font-size: 13px;
        vertical-alignment: center;
    }
}
