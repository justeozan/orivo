// The Selector is intentionally a single scene: game media provides the warmth,
// while the UI stays quiet, translucent, and anchored to the same safe areas.

component StrokeIcon inherits Path {
    in property <string> path-data: "";
    in property <color> tone: #d8d5dd;

    width: 18px;
    height: 18px;
    fill: transparent;
    stroke: root.tone;
    stroke-width: 1.7px;
    stroke-line-cap: round;
    stroke-line-join: round;
    viewbox-x: 0;
    viewbox-y: 0;
    viewbox-width: 24;
    viewbox-height: 24;
    commands: root.path-data;
}

component OrivoMark inherits Path {
    width: 31px;
    height: 29px;
    fill: #7d54f4;
    viewbox-x: 0;
    viewbox-y: 0;
    viewbox-width: 32;
    viewbox-height: 30;
    commands: "M 2 28 C 4 18 7 8 13 3 C 15 1 18 1 20 3 C 26 8 29 18 30 28 L 23 28 C 22 21 20 15 17 12 C 14 14 11 20 10 28 Z M 12 21 C 14 19 18 19 20 21 L 21 25 L 11 25 Z";
}

// Keep the chrome optically quiet. Every control samples the same pre-blurred
// viewport at its real position, rather than re-centering a miniature hero in
// each surface.
component FrostedGlass inherits Rectangle {
    in property <image> backdrop-image;
    in property <length> scene-width: 1536px;
    in property <length> scene-height: 1024px;
    in property <color> tint: #0b0d1422;
    in property <color> rim: #ffffff25;
    in property <duration> rim-cycle: 4700ms;
    in-out property <bool> rim-phase: false;

    background: transparent;
    border-width: 1px;
    border-color: root.rim;
    clip: true;

    // The source is a low-resolution, strongly blurred full viewport. Offset
    // it by this component's actual window position, then clip to the glass.
    // This is a backdrop blur, not a copied game image inside a button.
    Image {
        x: -root.x;
        y: -root.y;
        width: root.scene-width;
        height: root.scene-height;
        source: root.backdrop-image;
        image-fit: fill;
        opacity: root.backdrop-image.width > 0 ? 0.82 : 0;
        accessible-role: none;
    }
    Rectangle {
        width: parent.width;
        height: parent.height;
        background: root.tint;
        border-radius: root.border-radius;
    }

    // A few discontinuous one-pixel catches make the outline feel like real
    // reflected glass instead of a uniform UI stroke. Each consumer gives the
    // phase a slightly different cadence, so the chrome never pulses in sync.
    Rectangle {
        x: root.rim-phase ? parent.width * 0.54 : parent.width * 0.08;
        y: 0px;
        width: parent.width * 0.29;
        height: 1px;
        background: @linear-gradient(90deg, #ffffff00 0%, #ffffff72 50%, #ffffff00 100%);
        opacity: root.rim-phase ? 0.9 : 0.34;
        animate x { duration: 1650ms; easing: ease-in-out; }
        animate opacity { duration: 1650ms; easing: ease-in-out; }
    }
    Rectangle {
        x: parent.width - 1px;
        y: root.rim-phase ? parent.height * 0.54 : parent.height * 0.19;
        width: 1px;
        height: parent.height * 0.24;
        background: @linear-gradient(180deg, #ffffff00 0%, #ffffff5c 50%, #ffffff00 100%);
        opacity: root.rim-phase ? 0.28 : 0.64;
        animate y { duration: 1650ms; easing: ease-in-out; }
        animate opacity { duration: 1650ms; easing: ease-in-out; }
    }
    Rectangle {
        x: parent.width * 0.12;
        y: parent.height - 1px;
        width: parent.width * 0.2;
        height: 1px;
        background: @linear-gradient(90deg, #ffffff00 0%, #ffffff3f 50%, #ffffff00 100%);
        opacity: root.rim-phase ? 0.18 : 0.42;
        animate opacity { duration: 1650ms; easing: ease-in-out; }
    }
    Timer {
        interval: root.rim-cycle;
        running: true;
        triggered => { root.rim-phase = !root.rim-phase; }
    }
}

export component OrivoSelector inherits Window {
    title: "Orivo";
    width: 1536px;
    height: 1024px;
    background: #0b0b0d;

    callback import-game();
    callback play-game();
    callback previous-game();
    callback next-game();
    callback select-game(int);

    in-out property <string> selected-title: "Elden Ring";
    in-out property <string> selected-description: "A vast world full of mystery and peril. What will you discover?";
    in-out property <string> selected-play-time: "128h played";
    in-out property <string> selected-last-played: "Last played 2 days ago";
    in-out property <string> selected-progress: "Achievements 67/82";
    in-out property <string> status-text: "Ready to play";
    in-out property <string> rail-position: "1 / 1";
    in-out property <int> selected-index: 0;
    in-out property <int> rail-first-index: 0;
    in-out property <[image]> rail-covers;
    in-out property <[string]> rail-titles;
    in-out property <[string]> rail-metadata;
    in-out property <image> hero-image;
    in-out property <image> glass-backdrop-image;
    in-out property <image> avatar-image;

    // Media and the three deliberately restrained readability overlays.
    Rectangle { background: #0b0b0d; }

    Image {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: parent.height;
        source: root.hero-image;
        image-fit: cover;
        opacity: root.hero-image.width > 0 ? 0.84 : 0;
        accessible-role: none;
        animate opacity { duration: 220ms; easing: ease-in-out; }
    }

    Rectangle {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: parent.height;
        // A single falloff avoids visible stop seams in the software renderer
        // while keeping the left-side typography as quiet as the reference.
        background: @linear-gradient(90deg, #090a0ee8 0%, #090a0e00 74%);
    }

    Rectangle {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: parent.height;
        background: @linear-gradient(0deg, #08090de8 0%, #08090d6a 24%, #08090d00 49%, #08090d45 100%);
    }

    Rectangle {
        x: 0px;
