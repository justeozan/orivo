package orivo:plugin@1.0.0;

/// Common, serialisable types shared by every Orivo plugin world.
///
/// IDs are opaque host references. They are never filesystem paths, command
/// lines, handles into SQLite, or DOM/IPC capabilities.
interface types {
  enum extension-kind {
    source,
    runner,
    metadata,
    search,
    automation,
    ui-contribution,
  }

  enum plugin-error-code {
    invalid-input,
    permission-denied,
    unavailable,
    rate-limited,
    cancelled,
    internal,
  }

  record plugin-error {
    code: plugin-error-code,
    /// Presentation-safe sentence. The host keeps raw paths, secrets and
    /// implementation backtraces in its private diagnostic log.
    message: string,
    retryable: bool,
  }

  record page-request {
    /// Empty for the first page; otherwise a cursor previously returned by
    /// this exact plugin and operation.
    cursor: option<string>,
    limit: u32,
  }

  record page-info {
    next-cursor: option<string>,
    complete: bool,
  }

  record external-reference {
    provider-id: string,
    external-id: string,
  }

  record game-candidate {
    reference: external-reference,
    title: string,
    sort-title: option<string>,
    platform: option<string>,
    installed: bool,
  }

  record media-candidate {
    kind: string,
    url: string,
    width: option<u32>,
    height: option<u32>,
  }

  record command-contribution {
    id: string,
    title: string,
    subtitle: option<string>,
    icon: option<string>,
  }

  record badge-contribution {
    id: string,
    label: string,
    tone: string,
  }
}

/// Every plugin exports this surface. Startup and health checks are short,
/// never network-backed, and receive host grants only through imported host
/// calls in a later capability-specific ABI revision.
interface plugin-core {
  use types.{extension-kind, plugin-error};

  record identity {
    id: string,
    version: string,
    extensions: list<extension-kind>,
  }

  record health {
    ready: bool,
    message: option<string>,
  }

  get-identity: func() -> identity;
  health-check: func() -> result<health, plugin-error>;
}

/// Host-owned reads, scoped by grant. A plugin never receives a filesystem
/// path: it receives an opaque grant the user approved, and only the host knows
/// which directory it names.
///
/// Two different things gate this interface, and the difference is worth knowing
/// before you write a manifest. An import your manifest does not *declare* is
/// absent from the host's linker, so a component that needs one cannot be
/// instantiated at all — it never executes a single instruction under a
/// permission its package did not show the user. An import you declared but the
/// user has not yet *granted* is linked, and every call through it is refused
/// with `permission-denied`: that is the state a plugin is in between being
/// installed and being configured, and it is how the host can ask who you are
/// before trusting you with anything.
interface host-files {
  use types.{plugin-error};

  record directory-entry {
    name: string,
    byte-size: u64,
    directory: bool,
  }

  /// Lists one granted directory. The listing is bounded and never recursive,
  /// and it omits symbolic links rather than resolving them. A directory with
  /// more entries than the host will report is truncated to the first of them by
  /// name, so paging it is stable across calls but cannot reach past that bound.
  list-directory: func(grant: string) -> result<list<directory-entry>, plugin-error>;

  /// `name` is a single ordinary path component of that directory, never a
  /// path. The host rejects separators, `.`, `..`, control characters and `:`
  /// — a Windows drive prefix would otherwise discard the grant entirely — and
  /// it opens the entry without following a symbolic link and without blocking,
  /// then refuses anything that is not a regular file of an allowed size. The
  /// name does not have to have come from `list-directory`, but it does have to
  /// survive all of that.
  read-file: func(grant: string, name: string) -> result<list<u8>, plugin-error>;
}

/// The host's diagnostic journal. This is not a capability: a plugin that runs
/// at all may explain itself, and a refused grant is only auditable when the
/// attempt is recorded beside it.
///
/// It is still metered like every other host call, and messages are truncated.
/// They are kept in their own ring, apart from the host's record of its
/// decisions, so logging cannot push those decisions out. Note what that does
/// *not* promise: the host's ring is bounded too, and a plugin that earns enough
/// refusals in one session will scroll the earlier ones out of it. Nothing here
/// reaches the WebView as-is.
interface host-journal {
  enum journal-level {
    debug,
    info,
    warning,
    error,
  }

  log: func(level: journal-level, message: string);
}

/// Source discovery is paginated and resumable. The plugin never writes the
/// library itself: Orivo normalises candidates and commits one transaction.
interface source {
  use types.{game-candidate, page-info, page-request, plugin-error};

  record discovery-page {
    games: list<game-candidate>,
    page: page-info,
  }

  discover-page: func(request: page-request) -> result<discovery-page, plugin-error>;
}

/// A runner prepares a typed launch intent from opaque IDs. It cannot return
/// an executable path, a ROM path, a shell command or arbitrary arguments.
interface runner {
  use types.{game-candidate, page-info, page-request, plugin-error};

  record runner-profile {
    id: string,
    display-name: string,
  }

  record profile-validation {
    valid: bool,
    message: option<string>,
  }

  record runner-game-page {
    games: list<game-candidate>,
    page: page-info,
  }

  record launch-intent {
    runner-id: string,
    profile-id: string,
    game-reference: string,
    /// The host recognises these declared modes. It owns the final process,
    /// working directory and tokenised arguments for the selected profile.
    mode: string,
  }

  validate-profile: func(profile: runner-profile) -> result<profile-validation, plugin-error>;
  discover-page: func(profile-id: string, request: page-request) -> result<runner-game-page, plugin-error>;
  prepare-launch: func(profile-id: string, game-reference: string) -> result<launch-intent, plugin-error>;
}

interface metadata {
  use types.{external-reference, media-candidate, plugin-error};

  record game-metadata {
    description: option<string>,
    genres: list<string>,
    media: list<media-candidate>,
  }

  enrich: func(reference: external-reference) -> result<game-metadata, plugin-error>;
}

/// UI stays declarative. Orivo renders its own accessible controls and does
/// not accept HTML, CSS, JavaScript, event listeners, or raw routes.
interface ui-contrib {
  use types.{badge-contribution, command-contribution, plugin-error};

  record ui-contributions {
    commands: list<command-contribution>,
    badges: list<badge-contribution>,
    /// JSON schema stored as data and rendered by Orivo's settings controls.
    settings-schema: option<string>,
  }

  contributions: func() -> result<ui-contributions, plugin-error>;
}

/// A page of the Store, as data. The plugin names a tab, the colour the page
/// takes while it is open and the games on its shelf; Orivo renders all of it
/// with its own components and opens a game's page through its own opener.
/// Nothing here is HTML, CSS, a route or a script.
///
/// Every field is checked again by the host, which drops what it will not show
/// rather than guessing: a colour that is not `#rrggbb`, a picture or a page
/// that is not plain `https`, a price in something that is not a currency code.
/// It refuses the whole answer when the shape is wrong: more than four tabs,
/// more than 120 games in one, two tabs with one key, two games in a tab with
/// one id, an id outside its grammar, a label or a title with nothing in it.
///
/// The manifest declares this with the `store_tab` extension. `get-identity`
/// has no `extension-kind` for it, because a new case would break every
/// component built against v1, so a plugin that only adds a tab reports none.
interface store-tabs {
  use types.{plugin-error};

  /// Minor units of an ISO 4217 currency, counted the way Orivo's own offers
  /// are: 1999 in `EUR` is 19,99 €, and 0 is free.
  record store-price {
    currency: string,
    amount-minor: u32,
    /// What it cost before this offer. Absent, or not above `amount-minor`,
    /// shows no discount.
    regular-amount-minor: option<u32>,
  }

  record store-tab-game {
    /// Unique within its tab: ASCII letters, digits, `.`, `_` and `-`, at most
    /// 64 bytes. Orivo prefixes it with the plugin's id, so it can never name
    /// a game of the library or of another plugin.
    id: string,
    title: string,
    short-description: option<string>,
    /// Pictures, `https` only: a portrait cover, a wide hero, a landscape
    /// capsule and a transparent logo. The WebView's content policy still
    /// decides which hosts it loads them from.
    cover-url: option<string>,
    hero-url: option<string>,
    landscape-url: option<string>,
    logo-url: option<string>,
    /// At most four are shown.
    genres: list<string>,
    price: option<store-price>,
    /// An `https` page the player can open in their browser. Orivo keeps the
    /// address; the WebView only learns that there is one.
    page-url: option<string>,
  }

  record store-tab {
    /// Tells two tabs of one plugin apart: lowercase letters, digits and `-`,
    /// at most 32. A plugin with a single tab can leave it out.
    key: option<string>,
    /// At most 32 characters are shown.
    label: string,
    /// `#rrggbb`. Without one, the tab takes Orivo's own violet.
    accent: option<string>,
    /// A tab with no games is not shown.
    games: list<store-tab-game>,
  }

  /// Short, and never network-backed: this world imports nothing that could
  /// fetch. The answer is therefore a function of the component alone, and
  /// Orivo asks once for each package it has installed, not once per visit.
  tabs: func() -> result<list<store-tab>, plugin-error>;
}

world source-plugin {
  export plugin-core;
  export source;
}

world runner-plugin {
  import host-journal;
  import host-files;
  export plugin-core;
  export runner;
}

world metadata-plugin {
  export plugin-core;
  export metadata;
}

world ui-plugin {
  export plugin-core;
  export ui-contrib;
}

/// A plugin that adds pages to the Store. A component may also be a runner: it
/// then targets a world of its own that includes both, and Orivo calls each
/// half through the world that names it.
world store-tab-plugin {
  import host-journal;
  export plugin-core;
  export store-tabs;
}
