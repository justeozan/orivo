{
  "$schema": "../gen/schemas/desktop-schema.json",
  "productName": "Orivo",
  "version": "0.2.0",
  "identifier": "io.orivo.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Orivo",
        "width": 1536,
        "height": 1024,
        "minWidth": 1040,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": true,
        "decorations": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self' asset: http://asset.localhost; img-src 'self' asset: http://asset.localhost data: blob:; media-src 'self' asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost",
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPCACHE/media/**/*"]
      },
      "capabilities": ["main-window"]
    }
  },
  "bundle": {
    "active": true,
    "category": "Entertainment",
    "shortDescription": "A focused local game library",
    "longDescription": "Orivo is a local-first game library with a cinematic selector."
  }
}
