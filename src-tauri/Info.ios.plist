<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  Merged into the generated iOS Info.plist by `tauri ios dev` / `tauri ios
	  build` on every run. The iOS 27 SDK traps at launch for any app without a
	  static UIApplicationSceneManifest ("UIScene life cycle is required for
	  apps built with this SDK"); it only inspects this plist, so tao's
	  programmatic application:configurationForConnectingSceneSession: does not
	  satisfy it. UISceneDelegateClassName must be exactly TaoSceneDelegate —
	  tao's Objective-C runtime class name — and UIApplicationSupportsMultipleScenes
	  must be true, since tao gates its whole scene startup path on that key.
	-->
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<true/>
		<key>UISceneConfigurations</key>
		<dict>
			<key>UIWindowSceneSessionRoleApplication</key>
			<array>
				<dict>
					<key>UISceneConfigurationName</key>
					<string>Default Configuration</string>
					<key>UISceneDelegateClassName</key>
					<string>TaoSceneDelegate</string>
				</dict>
			</array>
		</dict>
	</dict>
	<!--
	  Landscape only on iPhone, as on Android (`lock_android_landscape` in
	  src/lib.rs): portrait leaves every row of the rail-based library too
	  narrow to read, and the compact layout is drawn for a phone held
	  sideways. iPad keeps the four orientations of the generated
	  `UISupportedInterfaceOrientations~ipad` — its portrait is a tablet-width
	  window, not a phone. Both sides are listed so the phone can be held
	  either way round.
	-->
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<!--
	  Export compliance, answered once for every build instead of in App Store
	  Connect each time. The only encryption Orivo uses is TLS: the WebView's
	  for pages, rustls's for the host's own HTTPS requests to the stores, and
	  the system keychain for credentials. Nothing proprietary, nothing that
	  encrypts user data of its own, and information security is not what the
	  app is for, which is the exemption. Revisit if that ever stops being true.
	-->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
</dict>
</plist>
