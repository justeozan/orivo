{
  "name": "orivo",
  "version": "0.4.11",
  "private": true,
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "packageManager": "pnpm@11.8.0",
  "scripts": {
    "dev": "vite",
    "build": "pnpm typecheck && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "check": "pnpm check:web && pnpm check:rust",
    "check:web": "pnpm typecheck && pnpm test",
    "check:rust": "vite build && cargo test --workspace",
    "tauri": "tauri",
    "store:refresh": "node scripts/fetch-store-catalog.mjs && node scripts/fetch-store-scenes.mjs && node scripts/build-store-catalog.mjs && node scripts/prune-store-media.mjs --apply && node scripts/compress-media.mjs",
    "store:build": "node scripts/build-store-catalog.mjs",
    "registry:sign": "node plugin-registry/scripts/sign.mjs",
    "registry:verify": "node plugin-registry/scripts/verify.mjs",
    "screenshots:app-store": "node scripts/app-store-screenshots.mjs"
  },
  "dependencies": {
    "@sentry/browser": "^10.69.0",
    "@tauri-apps/api": "2.11.1",
    "@tauri-apps/plugin-opener": "~2.5.5",
    "@tauri-apps/plugin-process": "^2",
    "@tauri-apps/plugin-updater": "^2"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@sentry/vite-plugin": "^11.10.0",
    "@tauri-apps/cli": "2.12.0",
    "@types/node": "26.1.1",
    "esbuild": "0.27.3",
    "jsdom": "^30.0.1",
    "typescript": "7.0.2",
    "vite": "8.1.5",
    "vitest": "^4.1.10"
  }
}
